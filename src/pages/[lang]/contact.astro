---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }];
}

const lang = Astro.params.lang as Lang;
const email = t(lang, 'contact.emailValue');
---

<Base
  lang={lang}
  title={`${t(lang, 'contact.title')} — ${t(lang, 'site.name')}`}
  description={t(lang, 'contact.text')}
  path={`/${lang}/contact/`}
>
  <article class="static-page">
    <h1>{t(lang, 'contact.title')}</h1>
    <p>{t(lang, 'contact.text')}</p>
    <p>
      <a class="btn primary" href={`mailto:${email}`}>{email}</a>
    </p>
  </article>
</Base>
