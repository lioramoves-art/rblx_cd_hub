---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }];
}

const lang = Astro.params.lang as Lang;
const isRu = lang === 'ru';
---

<Base
  lang={lang}
  title={`${t(lang, 'disclaimer.title')} — ${t(lang, 'site.name')}`}
  description={t(lang, 'disclaimer.lead')}
  path={`/${lang}/disclaimer/`}
>
  <article class="static-page">
    <h1>{t(lang, 'disclaimer.title')}</h1>
    <p><strong>{t(lang, 'disclaimer.lead')}</strong></p>

    <h2>{isRu ? 'Независимый неофициальный фанатский сайт' : 'Independent, unofficial fan site'}</h2>
    <p>
      {isRu
        ? 'GameCodesHub — независимый неофициальный фанатский веб-сайт, который предоставляет информацию о промокодах и играх, доступных на платформе Roblox. Сайт не связан с Roblox Corporation, её дочерними компаниями или партнёрами, не одобряется, не спонсируется и не ассоциируется с ними, а также с разработчиками перечисленных игр. Ничто на этом сайте не указывает на официальные отношения, партнёрство, спонсорство, одобрение или авторизацию со стороны Roblox Corporation или любого разработчика игр.'
        : 'GameCodesHub is an independent, unofficial fan-made website that provides information about promotional codes and games available on the Roblox platform. GameCodesHub is not affiliated with, endorsed by, sponsored by, or otherwise associated with Roblox Corporation or any of its subsidiaries or partners, or with the developers of the games listed. Nothing on this website is intended to suggest an official relationship, partnership, sponsorship, endorsement, or authorization by Roblox Corporation or any game developer.'}
    </p>

    <h2>{isRu ? 'Товарные знаки и интеллектуальная собственность' : 'Trademarks and intellectual property'}</h2>
    <p>
      {isRu
        ? '«Roblox» и другие упоминаемые товарные знаки, названия игр, логотипы, изображения и прочая интеллектуальная собственность принадлежат их законным владельцам. Упоминания Roblox и отдельных игр делаются исключительно для идентификации и в информационных целях. GameCodesHub не претендует на право собственности на игры, игровые ресурсы, товарные знаки или другую интеллектуальную собственность третьих лиц.'
        : '“Roblox” and other referenced trademarks, game names, logos, images, and other intellectual property belong to their respective owners. References to Roblox and individual Roblox games are made solely for identification and informational purposes. GameCodesHub does not claim ownership of Roblox games, game assets, trademarks, or other third-party intellectual property.'}
    </p>

    <h2>{isRu ? 'Коды и награды' : 'Codes and rewards'}</h2>
    <p>
      {isRu
        ? 'Коды на сайте приводятся в информационных целях. Коды, награды, доступность и сроки действия могут меняться в любой момент и полностью контролируются разработчиками соответствующих игр. Мы собираем коды из публичных источников и даём ссылки на оригинальные материалы, чтобы вы могли проверить информацию. Работоспособность кодов не гарантируется.'
        : 'Game codes listed on this website are provided for informational purposes. Codes, rewards, availability, and expiration dates may change at any time and are controlled by the respective game developers. We collect codes from public sources and link to original articles so you can verify the information. Code availability is not guaranteed.'}
    </p>

    <h2>{isRu ? 'Данные и изображения' : 'Data and images'}</h2>
    <p>
      {isRu
        ? 'Описания игр и тексты сайта написаны нами и не копируют статьи-источники. Иконки игр загружаются в браузер напрямую с контент-серверов Roblox и не хранятся на наших серверах. Использование публично доступных сервисов и API Roblox не передаёт никаких прав на полученный через них контент: названия, изображения и товарные знаки остаются собственностью их владельцев.'
        : 'Game descriptions and site texts are written by us and do not copy the source articles. Game icons are loaded in your browser directly from Roblox content delivery servers and are not stored on our servers. The use of publicly available Roblox services and APIs does not transfer any rights to content obtained through them: game names, images, and trademarks remain the property of their respective owners.'}
    </p>

    <h2>{isRu ? 'Удаление контента' : 'Content removal'}</h2>
    <p>
      {isRu
        ? 'Если вы правообладатель и считаете, что материал на GameCodesHub должен быть удалён или изменён — свяжитесь с нами через контакты на сайте. Мы удалим спорный контент оперативно и без судебных формальностей.'
        : 'If you are a rights holder and believe that content on GameCodesHub should be removed or modified, please contact us using the contact information provided on this website. We will remove the disputed content promptly and without legal formalities.'}
    </p>
    <p class="muted">
      <a href={`mailto:${t(lang, 'contact.emailValue')}`}>{t(lang, 'contact.emailValue')}</a>
    </p>
  </article>
</Base>
